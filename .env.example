# 간단 참조용. 각 변수 설명은 .env.local.example 을 보세요.
# 두 파일의 변수명은 반드시 동일하게 유지합니다.

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Kakao Maps — 아직 코드에서 사용하지 않음 (지도는 외부 링크 방식)
NEXT_PUBLIC_KAKAO_MAP_API_KEY=

# 폼 알림 (Resend) — 미설정 시 폼이 성공 대신 전화 안내를 표시함
RESEND_API_KEY=
FORM_NOTIFY_TO=
FORM_NOTIFY_FROM=

# Site URL — 미설정 시 코드 기본값(vercel.app)이 쓰입니다. src/lib/site.ts 참고
NEXT_PUBLIC_SITE_URL=
