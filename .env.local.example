# ════════════════════════════════════════════════════════════
#  청파중앙교회 홈페이지 환경변수
#  복사 방법: cp .env.local.example .env.local
#  Vercel: 대시보드 → Settings → Environment Variables 에 동일하게 입력
# ════════════════════════════════════════════════════════════

# ─── Sanity CMS ──────────────────────────────────────────────────────────────
# 프로젝트 생성: https://www.sanity.io/get-started
# Project ID: sanity.io/manage → 프로젝트 선택 → Settings → API
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity API 토큰 (sanity.io/manage → API → Tokens)
# Read Token : Viewer 권한 — draft 미리보기용
# Write Token: Editor 권한 — 시딩 스크립트 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# ─── Kakao Maps (오시는 길 지도 연동) ────────────────────────────────────────
# ⚠️ 현재 이 변수를 읽는 코드가 없습니다. 지도는 카카오맵 외부 링크 방식입니다.
#    카카오맵 SDK를 실제로 붙일 때 사용하세요.
# https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
# Vercel 도메인을 kakao developers 허용 사이트에 추가 필요
NEXT_PUBLIC_KAKAO_MAP_API_KEY=

# ─── 폼 알림 (Resend) ────────────────────────────────────────────────────────
# 방문 신청(/visit)과 문의(/contact) 접수를 이메일로 받는다.
#
# ⚠️ 이 세 값이 없으면 폼은 "접수되었습니다" 대신 전화 안내와 함께 실패를
#    표시한다. 의도된 동작이다 — 아무도 못 받는 접수를 성공으로 알리지 않는다.
#
# RESEND_API_KEY  : resend.com → API Keys 에서 발급
# FORM_NOTIFY_TO  : 알림을 받을 주소. 콤마로 여러 개 지정 가능
# FORM_NOTIFY_FROM: 발신 주소. Resend에서 인증한 도메인이어야 한다.
#                   미설정 시 onboarding@resend.dev 로 발송되며,
#                   이 테스트 발신자는 Resend 계정 소유자에게만 전달된다.
RESEND_API_KEY=
FORM_NOTIFY_TO=
FORM_NOTIFY_FROM=

# ─── 사이트 URL (canonical / OG / sitemap / robots 공용) ─────────────────────
# 미설정 시 src/lib/site.ts 의 기본값(https://welcomehome-seven.vercel.app)이 쓰입니다.
# chungpa21.org 도메인 이전 완료 후 https://chungpa21.org 로 변경하세요.
NEXT_PUBLIC_SITE_URL=

# ─── Sanity Studio 환경변수 (sanity/.env 별도 파일) ──────────────────────────
# sanity/ 폴더 안에 별도로 sanity/.env 파일을 만들어 아래 값을 입력하세요.
#
#   SANITY_STUDIO_PROJECT_ID=your_project_id_here
#   SANITY_STUDIO_DATASET=production
